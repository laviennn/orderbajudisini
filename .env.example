# Missing services stay unavailable; never place server secrets in NEXT_PUBLIC_*.
APP_URL=http://localhost:3000
DATABASE_URL=
# At least 32 characters. Login remains disabled until the identity method is implemented.
AUTH_SECRET=
# Secret for automated background jobs (e.g., expiry cron). At least 16 characters.
CRON_SECRET=
AUTH_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
# Shipping: leave empty until a real adapter is configured. "test" is DEV/TEST only.
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
NEXT_PUBLIC_GTM_ID=
